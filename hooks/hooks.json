{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-latest.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking for Threenix updates"
          }
        ]
      }
    ]
  }
}
